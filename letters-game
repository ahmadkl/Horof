function showScreen(name) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  const el = $('screen-' + name);
  if (el) el.classList.add('active');
}

/* =========================================================
   7) بدء اللغة
   ========================================================= */

function startLang(lang) {
  soundClick();
  state.lang = lang;
  state.score = 0;
  state.letterIndex = 0;
  $('menu-lang').textContent = lang === 'ar' ? '🇸🇦 العربية' : '🇬🇧 English';
  $('menu-title').textContent = lang === 'ar' ? 'اختر النشاط' : 'Choose an Activity';
  $('menu-sub').textContent = lang === 'ar'
    ? 'ماذا تريد أن تتعلم اليوم؟'
    : 'What do you want to learn today?';
  showScreen('menu');
  speak(lang === 'ar' ? 'هيا نتعلم الحروف العربية' : 'Let us learn English letters', langCode());
}

/* =========================================================
   8) وضع التعلم
   ========================================================= */

function startLearn() {
  soundClick();
  state.mode = 'learn';
  state.letterIndex = 0;
  renderLetter(true);
  showScreen('learn');
}

function renderLetter(autoSpeak) {
  const letters = currentLetters();
  const item = letters[state.letterIndex];

  $('learn-letter').textContent = item.l;
  $('learn-emoji').textContent = item.e;
  const wordEl = $('learn-word');
  wordEl.textContent = item.w;
  wordEl.classList.toggle('en', state.lang === 'en');
  $('learn-progress').textContent = (state.letterIndex + 1) + ' / ' + letters.length;

  $('prev-btn').disabled = (state.letterIndex === 0);
  $('next-btn').disabled = (state.letterIndex === letters.length - 1);

  if (autoSpeak) {
    stopSpeaking();
    setTimeout(() => speak(item.l, langCode()), 180);
    setTimeout(() => speak(item.w, langCode()), 1150);
  }
}

function speakCurrentLetter() {
  const item = currentLetters()[state.letterIndex];
  soundClick();
  speak(item.l, langCode());
}
function speakCurrentWord() {
  const item = currentLetters()[state.letterIndex];
  soundClick();
  speak(item.w, langCode());
}
function nextLetter() {
  const letters = currentLetters();
  if (state.letterIndex < letters.length - 1) {
    state.letterIndex++;
    soundClick();
    renderLetter(true);
  }
}
function prevLetter() {
  if (state.letterIndex > 0) {
    state.letterIndex--;
    soundClick();
    renderLetter(true);
  }
}

/* =========================================================
   9) توليد الأسئلة
   ========================================================= */

function pickOptions(correctObj, key, count) {
  const pool = currentLetters();
  const opts = [correctObj];
  const used = new Set([correctObj[key]]);
  let guard = 0;
  while (opts.length < count && guard < 800) {
    guard++;
    const cand = pool[randInt(pool.length)];
    if (!used.has(cand[key])) {
      used.add(cand[key]);
      opts.push(cand);
    }
  }
  return shuffle(opts);
}

function buildQuestion() {
  const letters = currentLetters();
  const correct = letters[randInt(letters.length)];
  const type = Math.random() < 0.5 ? 'letter' : 'word';

  if (type === 'letter') {
    return {
      type: 'letter',
      correct: correct,
      textAr: 'ما هو الحرف الأول من هذه الكلمة؟',
      textEn: 'What is the first letter of this word?',
      options: pickOptions(correct, 'l', 4)
    };
  } else {
    return {
      type: 'word',
      correct: correct,
      textAr: 'اختر الكلمة التي تبدأ بهذا الحرف',
      textEn: 'Choose the word that starts with this letter',
      options: pickOptions(correct, 'w', 4)
    };
  }
}

/* =========================================================
   10) بدء التدريب / الاختبار
   ========================================================= */

function startGame(mode) {
  soundClick();
  state.mode = mode;
  state.score = 0;
  state.qNum = 0;
  state.answered = false;
  state.locked = false;
  state.totalQ = TOTAL_QUIZ_QUESTIONS;
  showScreen('game');
  nextQuestion();
}

function nextQuestion() {
  state.answered = false;
  state.locked = false;
  state.currentQ = buildQuestion();
  renderQuestion();
  updateHud();
}

function updateHud() {
  const hud = $('game-hud');
  if (state.mode === 'quiz') {
    const current = Math.min(state.qNum + 1, state.totalQ);
    hud.textContent = (state.lang === 'ar' ? 'سؤال ' : 'Q ') + current + '/' + state.totalQ + '  ⭐ ' + state.score;
  } else {
    hud.textContent = '✅ ' + state.score;
  }
}

function renderQuestion() {
  const q = state.currentQ;
  const promptArea = $('prompt-area');
  const optionsArea = $('options-area');
  const qText = $('question-text');
  const fb = $('feedback');

  fb.textContent = '';
  fb.className = 'feedback';

  if (state.lang === 'ar') {
    qText.innerHTML = q.textAr + '<span class="en-line">' + q.textEn + '</span>';
  } else {
    qText.innerHTML = q.textEn + '<span class="en-line" style="direction:rtl">' + q.textAr + '</span>';
  }

  promptArea.innerHTML = '';
  optionsArea.innerHTML = '';
  promptArea.onclick = null;

  if (q.type === 'letter') {
    const wordDiv = document.createElement('div');
    wordDiv.className = 'prompt-word' + (state.lang === 'en' ? ' en' : '');
    wordDiv.textContent = q.correct.w;

    const emojiDiv = document.createElement('div');
    emojiDiv.className = 'prompt-emoji';
    emojiDiv.textContent = q.correct.e;

    promptArea.appendChild(emojiDiv);
    promptArea.appendChild(wordDiv);
    promptArea.onclick = () => { soundClick(); speak(q.correct.w, langCode()); };

    q.options.forEach(o => {
      const b = document.createElement('button');
      b.className = 'opt letter-opt';
      b.textContent = o.l;
      b.dataset.value = o.l;
      b.onclick = () => handleAnswer(b, o.l === q.correct.l, o.l);
      optionsArea.appendChild(b);
    });

    stopSpeaking();
    setTimeout(() => speak(q.correct.w, langCode()), 400);

  } else {
    const letterDiv = document.createElement('div');
    letterDiv.className = 'prompt-letter';
    letterDiv.textContent = q.correct.l;
    promptArea.appendChild(letterDiv);
    promptArea.onclick = () => { soundClick(); speak(q.correct.l, langCode()); };

    q.options.forEach(o => {
      const b = document.createElement('button');
      b.className = 'opt word-opt';
      b.dataset.value = o.w;

      const em = document.createElement('span');
      em.className = 'opt-emoji';
      em.textContent = o.e;

      const wd = document.createElement('span');
      wd.className = 'opt-word';
      wd.textContent = o.w;

      b.appendChild(em);
      b.appendChild(wd);
      b.onclick = () => handleAnswer(b, o.w === q.correct.w, o.w);
      optionsArea.appendChild(b);
    });

    stopSpeaking();
    setTimeout(() => speak(q.correct.l, langCode()), 400);
  }
}

/* =========================================================
   11) معالجة الإجابة
   ========================================================= */

function praiseText() {
  const ar = ['أحسنت!', 'رائع!', 'ممتاز!', 'أنت بطل!', 'عمل جيد!', 'مذهل!'];
  const en = ['Great job!', 'Awesome!', 'Excellent!', 'You are a star!', 'Well done!', 'Super!'];
  return state.lang === 'ar' ? pickRandom(ar) : pickRandom(en);
}
function encourageText() {
  return state.lang === 'ar' ? 'حاول مرة أخرى' : 'Try again';
}

function handleAnswer(btn, isCorrect, value) {
  if (state.answered || state.locked) return;
  state.answered = true;
  state.locked = true;

  const q = state.currentQ;
  const allBtns = Array.from(document.querySelectorAll('#options-area .opt'));
  allBtns.forEach(b => { b.disabled = true; });

  const fb = $('feedback');

  if (isCorrect) {
    btn.classList.add('correct');
    state.score++;
    soundCorrect();
    fb.textContent = '🎉 ' + praiseText();
    fb.className = 'feedback ok';
    stopSpeaking();
    setTimeout(() => speak(praiseText(), langCode()), 260);
  } else {
    btn.classList.add('wrong');
    soundWrong();
    const correctValue = (q.type === 'letter') ? q.correct.l : q.correct.w;
    allBtns.forEach(b => {
      if (b.dataset.value === correctValue) b.classList.add('correct');
    });
    fb.textContent = '❌ ' + encourageText();
    fb.className = 'feedback no';
    stopSpeaking();
    setTimeout(() => speak(encourageText(), langCode()), 300);
  }

  updateHud();

  setTimeout(() => {
    if (state.mode === 'quiz') {
      state.qNum++;
      if (state.qNum >= state.totalQ) {
        endQuiz();
        return;
      }
    }
    nextQuestion();
  }, 1700);
}

/* =========================================================
   12) نهاية الاختبار
   ========================================================= */

function endQuiz() {
  const pct = state.totalQ > 0 ? state.score / state.totalQ : 0;
  let stars = 0;
  if (pct >= 0.9) stars = 3;
  else if (pct >= 0.6) stars = 2;
  else if (pct >= 0.3) stars = 1;
  else stars = 0;

  $('result-stars').textContent = '⭐'.repeat(stars) + '☆'.repeat(3 - stars);
  $('result-score').textContent = state.score + ' / ' + state.totalQ;

  let msg;
  if (stars === 3) msg = state.lang === 'ar' ? 'ممتاز! أنت بطل الحروف 🏆' : 'Perfect! You are a letters champion 🏆';
  else if (stars === 2) msg = state.lang === 'ar' ? 'عمل رائع! واصل التدريب 💪' : 'Great work! Keep practicing 💪';
  else if (stars === 1) msg = state.lang === 'ar' ? 'بداية جيدة! حاول مرة أخرى 🌟' : 'Good start! Try again 🌟';
  else msg = state.lang === 'ar' ? 'لا بأس، التدريب يصنع الأبطال 💙' : 'No worries, practice makes perfect 💙';

  $('result-msg').textContent = msg;
  $('result-title').textContent = state.lang === 'ar' ? 'انتهى الاختبار! 🎉' : 'Quiz Finished! 🎉';

  showScreen('result');
  stopSpeaking();

  if (stars >= 2) {
    soundCorrect();
    setTimeout(() => speak(state.lang === 'ar' ? 'ممتاز! أحسنت' : 'Excellent! Well done', langCode()), 500);
  } else {
    setTimeout(() => speak(state.lang === 'ar' ? 'حاول مرة أخرى، أنت تستطيع' : 'Try again, you can do it', langCode()), 400);
  }
}

/* =========================================================
   13) تهيئة أولية
   ========================================================= */

window.addEventListener('beforeunload', stopSpeaking);
document.addEventListener('visibilitychange', () => {
  if (document.hidden) stopSpeaking();
});

document.addEventListener('keydown', (e) => {
  if (!$('screen-learn').classList.contains('active')) return;
  if (e.key === 'ArrowLeft') nextLetter();
  if (e.key === 'ArrowRight') prevLetter();
  if (e.key === ' ') { e.preventDefault(); speakCurrentWord(); }
});

