const TOTAL_QUIZ_QUESTIONS = 10;

/* =========================================================
   2) حالة اللعبة
   ========================================================= */

const state = {
  lang: 'ar',
  mode: 'practice',
  letterIndex: 0,
  score: 0,
  qNum: 0,
  totalQ: TOTAL_QUIZ_QUESTIONS,
  currentQ: null,
  answered: false,
